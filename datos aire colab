from sklearn.metrics import mean_absolute_error, mean_squared_error

ARCHIVO = "Puente Aranda_pm25 (2).csv"  # el mismo nombre que use en la celda 2
orig = pd.read_csv(ARCHIVO, parse_dates=["Fecha inicial"])
fechas_reales = pd.DatetimeIndex(orig["Fecha inicial"])

real = df["pm25"].copy()
rng = np.random.default_rng(42)

# Solo valores que existían de verdad (no los rellenados)
candidatas = real.index[real.index.isin(fechas_reales)]
oculta = rng.choice(candidatas, size=int(len(candidatas) * 0.1), replace=False)

prueba = real.copy()
prueba.loc[oculta] = np.nan
reconstruida = prueba.interpolate(method="time")

mae = mean_absolute_error(real.loc[oculta], reconstruida.loc[oculta])
rmse = np.sqrt(mean_squared_error(real.loc[oculta], reconstruida.loc[oculta]))
print("Valores ocultados:", len(oculta))
print(f"MAE: {mae:.2f} | RMSE: {rmse:.2f} µg/m³")

