import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files
////////////////////////////////////////////////////////////////////////////////////////////
df = pd.read_csv("Puente Aranda_pm25 (2).csv", parse_dates=["Fecha inicial"])

print(df.shape)         # filas y columnas
print(df.head())        # primeras 5 filas
print(df.info())        # tipos de datos
print(df.isna().sum())  # cuántos vacíos hay en cada columna

///////////////////////////////////////////////////////////////////////////////////////////

df = df.rename(columns={"Fecha inicial": "fecha", "PM2.5": "pm25"})
df = df[["fecha", "pm25"]].sort_values("fecha").set_index("fecha")

print(df.index.min(), df.index.max())
print(df["pm25"].describe())

///////////////////////////////////////////////////////////////////////////////////////////

# Calendario diario completo (incluye los días que faltan)
idx = pd.date_range(df.index.min(), df.index.max(), freq="D")
df = df.reindex(idx)
print("Días en total:", len(df))
print("Días sin dato:", df["pm25"].isna().sum())

# Rellenar los huecos por interpolación en el tiempo
df["pm25"] = df["pm25"].interpolate(method="time")
print("Días sin dato después de rellenar:", df["pm25"].isna().sum())

